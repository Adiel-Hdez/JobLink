<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChatDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/ivChatContactAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_person"
            android:background="@drawable/bg_badge_orange"
            android:padding="6dp"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Contacto"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En línea"
                android:textColor="@color/teal_light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/chatHeader"
        android:layout_above="@id/layoutWorkOrderAction"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Create Work Order / Quote Button Container -->
    <LinearLayout
        android:id="@+id/layoutWorkOrderAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/chatInputBar"
        android:background="@color/bg_light"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearOrdenTrabajo"
            style="@style/ButtonOrange"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CREAR ORDEN DE TRABAJO / CITA" />
    </LinearLayout>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:id="@+id/chatInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnAttachImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_role_card_unselected"
            android:hint="Escribe un mensaje..."
            android:textColor="@color/navy_primary"
            android:textColorHint="@color/text_secondary"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_orange"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />
    </LinearLayout>

</RelativeLayout>